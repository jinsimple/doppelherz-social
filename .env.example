# Sao chep file nay thanh ".env" roi doi 2 mat khau ben duoi.
# File .env chi nam tren may nay, khong gui cho ai.
DB_PASSWORD=doi-mat-khau-nay
DB_ROOT_PASSWORD=doi-mat-khau-root-nay
# Ma bi mat dung chung giua WordPress va n8n (chuoi ngau nhien dai, chi chu va so)
SOCIALSYNC_SECRET=doi-ma-bi-mat-nay
# Facebook: ID va token Trang (token loai PAGE, lay qua /me/accounts)
FB_PAGE_ID=
FB_PAGE_TOKEN=
# Dia chi Custom webhook cua scenario Make "SocialSync - Pinterest" (ai biet dia chi nay deu tao duoc Pin)
MAKE_PINTEREST_WEBHOOK=
